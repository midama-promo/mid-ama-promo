# Application
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Neon PostgreSQL (use Neon pooled connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Session and OTP security (generate long random values)
MID_AMA_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
OTP_HASH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# Resend email OTP + notifications
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=Mid-Ama Promo <no-reply@your-verified-domain.example>
ADMIN_NOTIFICATION_EMAIL=midnightamapiano@yahoo.com

# Cloudflare R2 (private bucket)
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET_NAME=mid-ama-promo-files
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY

# Optional integrations
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
DOWNLOAD_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
