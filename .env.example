# Gemini (optional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL
APP_URL="https://your-production-domain.example"

# REQUIRED FOR PRODUCTION PERSISTENCE
# Create these in Supabase and keep the service-role key SERVER ONLY.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
# Public Supabase key used server-side only to request/verify email OTPs. Never use the service-role key for this.
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"
# Dedicated signing secret for Mid-Ama application sessions. Generate a long random value.
MID_AMA_SESSION_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Optional email configuration
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT="587"
# SMTP_USER="postmaster@midamapromo.com"
# SMTP_PASS="YOUR_SMTP_PASSWORD"
# NOTIFICATION_FROM_EMAIL="midnightamapiano@yahoo.com"

# Strong secret for temporary download tickets.
DOWNLOAD_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
# Optional transactional email for admin submission/query/takedown notifications
RESEND_API_KEY="YOUR_RESEND_API_KEY"
EMAIL_FROM="Mid-Ama Promo <no-reply@midamapromo.co.za>"
ADMIN_NOTIFICATION_EMAIL="midnightamapiano@yahoo.com"
